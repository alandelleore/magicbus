{
  "expo": {
    "name": "MagicBus",
    "slug": "magicbus",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#F05510",
      "resizeMode": "contain"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "MagicBus necesita acceder a tu ubicación para encontrar paradas cercanas.",
          "locationWhenInUsePermission": "MagicBus necesita acceder a tu ubicación para encontrar paradas cercanas."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F05510"
      },
      "package": "com.magicbus.app",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "platforms": [
      "android"
    ],
    "extra": {
      "eas": {
        "projectId": "4d096c25-f6af-4842-ae7f-395f19a388ff"
      }
    },
    "owner": "alandelleore"
  }
}
